# ─────────────────────────────────────────────────────────────────────────
# EurekaSi — variables de entorno (producción)
# Configúralas en el panel de tu hosting (Vercel/Netlify), NO las subas al repo.
# ─────────────────────────────────────────────────────────────────────────

# PostgreSQL gestionado (Neon, Supabase, Vercel Postgres…). Usa la cadena
# "pooled"/pgbouncer para serverless si tu proveedor la ofrece.
DATABASE_URL=postgres://usuario:password@host/db?sslmode=require

# Autenticación del admin.
# 1) Genera el hash:  npm run hash:password -- "tu-contraseña-larga"
# 2) Pega el resultado (formato salt:hash) aquí:
ADMIN_PASSWORD_HASH=

# Secreto para firmar la cookie de sesión (mínimo 16 chars, aleatorio).
# Genera uno con:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Email de notificación de leads (opcional — vía Resend https://resend.com).
# Si no lo configuras, los leads igual se guardan en la base de datos.
RESEND_API_KEY=
LEAD_NOTIFY_FROM=EurekaSi <leads@tudominio.pt>
LEAD_NOTIFY_TO=equipo@tudominio.pt
